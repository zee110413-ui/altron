# Whitelist approach: ignore everything at root, then re-include source dirs
/*
!/.gitignore
!/.gitattributes
!/.github/
!/docs/
!/*.bat
!/*.txt
!/*.md
!/mod/
!/brain/
# ai_server/ (the kit for a second PC) is built by brain/build_pc2_kit.py and copied over, not kept in git

# Per-PC state and caches made at run time (the encyclopedia cache is rebuilt from the pack's files)
brain/last_launch.json
brain/knowledge_cache.json
# training data exported from his experience (TRAINING.md): personal, and big
brain/*.jsonl
# personal notes and launchers for one particular world
/ДЛЯ_НОВОГО_ЧАТА.txt
/Альтрон в Лос-Перрито.bat

# Python venvs, caches, logs, runtime memory (not source)
**/venv/
**/.venv/
**/__pycache__/
**/logs/
**/memory/
**/memory_demo/
**/memory_test/
*.pyc

# Java/Gradle build output
**/.gradle/
**/build/
*.class

# Binaries, archives, model weights
*.gguf
*.jar
!mod/gradle/wrapper/gradle-wrapper.jar
*.zip
*.exe

# Big generated reports
polygon_report.txt
polygon_report_hodba.txt
